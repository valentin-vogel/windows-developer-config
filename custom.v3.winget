# Dev-Config — Developer Workstation Setup
# Apply with: winget configure -f dev.v3.winget --accept-configuration-agreements --disable-interactivity

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: "dscv3"
resources:
# =============================================================================
# Software — Applications, Tools, Runtimes, SDKs, CLIs, etc.
# =============================================================================
- name: AzureCLI
  type: Microsoft.WinGet/Package
  properties:
    id: "Microsoft.AzureCLI"
    source: "winget"

- name: Azure.StorageExplorer
  type: Microsoft.WinGet/Package
  properties:
    id: "Microsoft.Azure.StorageExplorer"
    source: "winget"

- name: Azure.DataStudio
  type: Microsoft.WinGet/Package
  properties:
    id: "Microsoft.Azure.DataStudio"
    source: "winget"

- name: Foxit.FoxitReader
  type: Microsoft.WinGet/Package
  properties:
    id: "Foxit.FoxitReader"
    source: "winget"

- name: VisualStudio
  type: Microsoft.WinGet/Package
  properties:
    id: "Microsoft.VisualStudio.Enterprise"
    source: "winget"

# =============================================================================
# Registry — HKLM keys (elevated, native v3 Microsoft.Windows/Registry)
# =============================================================================
