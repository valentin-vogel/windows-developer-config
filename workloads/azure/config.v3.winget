#################################################################################
# Azure Setup
# Apply with: winget configure -f config.v3.winget --accept-configuration-agreements --disable-interactivity
################################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: "dscv3"
resources:
# =============================================================================
# Software
# =============================================================================
- name: AzureCLI
  type: Microsoft.WinGet/Package
  properties:
    id: "Microsoft.AzureCLI"
    source: "winget"

- name: Azure.StorageExplorer
  type: Microsoft.WinGet/Package
  properties:
    id: "Microsoft.Azure.StorageExplorer"
    source: "winget"

- name: Azure.DataStudio
  type: Microsoft.WinGet/Package
  properties:
    id: "Microsoft.Azure.DataStudio"
    source: "winget"
