    source: "winget"

- name: Microsoft.Edge
  type: Microsoft.WinGet/Package
  properties:
    id: "Microsoft.Edge"
    source: "winget"

- name: Git
  type: Microsoft.WinGet/Package
  properties:
    id: Git.Git
    source: winget

- name: Coreutils
  type: Microsoft.WinGet/Package
  dependsOn:
